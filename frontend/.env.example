# ── Frontend Environment Variables ──────────────────────────────────
# Copy this file to .env.local for local development
# In Vercel dashboard, add these as Environment Variables

# The base URL of your deployed FastAPI backend
# For Vercel monorepo deployment, use relative path (empty string so axios uses relative URLs)
# For separate backend deployment (e.g., Railway, Render), use the full URL:
# VITE_API_BASE_URL=https://your-backend.railway.app
VITE_API_BASE_URL=
