*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ─── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Sensitive / Secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Model weights (large binary files — do NOT commit) ───────────────────────
*.safetensors
*.bin
*.pt
*.pth
*.onnx
nlp_model/models/

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm/

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs & temp output ───────────────────────────────────────────────────────
*.log
*.txt.bak
out.txt
smoke_test_output.txt
test_out*.txt
test_output*.txt
test_results.txt
test_final.txt
